mncs 0.3;

module examples.contracts;

fn bounded_step(n: i64, limit: i64) -> (result: i64)
    requires n_within_limit
    capability checked_integer
{
    if n > limit {
        fail isolated;
    }
    let next: i64 = n + 1;
    return next;
}

fn caller(value: i64) -> (result: i64)
    capability checked_integer
{
    return bounded_step(value, value);
}
